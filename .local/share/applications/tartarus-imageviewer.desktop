[Desktop Entry]
Type=Application
Name=Tartarus Image Viewer
Comment=Open images in Tartarus Image Viewer
Exec=tartarus-imageviewer %f
TryExec=tartarus-imageviewer
Terminal=false
NoDisplay=true
StartupNotify=false
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;image/svg+xml;
Categories=Graphics;Viewer;
